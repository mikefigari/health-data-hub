{
  "name": "health-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test \"test/unit/**/*.test.mjs\"",
