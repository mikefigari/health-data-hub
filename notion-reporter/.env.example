# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=health
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Notion ───────────────────────────────────────────────────────────────────
NOTION_TOKEN=ntn_...

# The Health Intelligence report database (pre-configured)
NOTION_HEALTH_INTELLIGENCE_DB_ID=327993b9020180aebd93f4868fb43209

# Your existing workout sync database
NOTION_WORKOUT_DB_ID=4ff202f13d1f463a8201508ac8814cd9

# Your existing Daily Physical State database
NOTION_DAILY_STATE_DB_ID=2cf993b902018042b154c7e7ff4d5d82

# Optional: PowerZone training block database.
# If set, the reporter will query for the currently active block and link it.
# Leave blank to skip — the report will still post without this relation.
NOTION_POWERZONE_DB_ID=

# Optional: the Notion property name that holds the date range on your PowerZone
# block pages (used to find the currently active block). Defaults to "Date".
NOTION_POWERZONE_DATE_PROP=Date

# ── Report mode ──────────────────────────────────────────────────────────────
# daily | weekly | dry
# dry: assembles context and prints the prompt without calling Claude or Notion
REPORT_MODE=daily

# ── Daily data gate / retry behavior ────────────────────────────────────────
# When true (default), daily mode waits and retries until required sources are
# present in PostgreSQL before generating/posting a report.
DAILY_RETRY_ENABLED=true

# Minutes between retries when required daily data is missing.
DAILY_RETRY_INTERVAL_MIN=30

# Comma-separated data_gate source names that must be present before daily
# prompt generation starts.
DAILY_REQUIRED_SOURCES=oura_sleep,oura_readiness,nutrition,pmc,physical_state
