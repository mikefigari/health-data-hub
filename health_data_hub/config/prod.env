# === Environment Selection ===
HEALTH_ENV=prod

# === Postgres Settings ===
DB_HOST=your_prod_host
DB_PORT=5432
DB_NAME=health
DB_USER=postgres
DB_PASSWORD=xxxx

# === Strava OAuth Settings ===
STRAVA_CLIENT_ID=xxxx
STRAVA_CLIENT_SECRET=xxxx
STRAVA_REDIRECT_URI=https://yourserver/exchange_token
STRAVA_SCOPE=activity:read_all

# === Notion Settings ===
NOTION_TOKEN=xxxx
NOTION_WORKOUT_DB_ID=xxxx
NOTION_DAILY_STATE_DB_ID=xxxx
